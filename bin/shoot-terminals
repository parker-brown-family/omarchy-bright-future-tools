#!/usr/bin/env bash
# The three-terminal portrait of this theme, staged and shot on a workspace:
# fastfetch on the left (the theme's own wallpaper as its sixel logo), the
# omarchy palette preview and btop stacked on the right, with the Super+Space
# menu open over the finished scene.
#
#   bin/shoot-terminals            -> screenshots/terminals.png + preview.png
#   bin/shoot-terminals --keep     leave the staged workspace up to look at
#   bin/shoot-terminals --close    only sweep up windows a --keep run left
#   bin/shoot-terminals --ws N     stage on another workspace (default 5)
#
# The panes photograph the LIVE palette, so the theme should be the current
# omarchy theme when this runs.
#
# Hard-won rules this script encodes (Hyprland 0.56 Lua dispatch, this box —
# each one measured, not guessed; bin/probe-dsp is the introspection tool):
#   - hl.dsp.focus({ workspace = N }) pulls the workspace to the FOCUSED
#     monitor; focus the landscape monitor first or btop lands on the
#     portrait screen at 61 columns and refuses to draw.
#   - Floats: hl.dsp.window.resize is EXACT but re-centres the float, and
#     hl.dsp.window.move x+y is ABSOLUTE top-left (relative is an opt-in
#     flag). Therefore: float -> resize -> move, in that order. Tiling is
#     not used for the panes at all — dwindle's split axis on this box
#     follows neither pane aspect nor cursor half reliably.
#   - NEVER touch hl.config here. Any config write reloads the config, the
#     reload recompiles the CRT glass shader, and with the clock on that
#     raises Hyprland's sticky red error banner across the shot. Cursor
#     hygiene is done by PARKING the pointer on another output instead of
#     borrowing cursor:inactive_timeout.
#   - hyprctl seterror disable closes an already-latched error banner; mako
#     is dismissed so nobody's notification is photographed by accident.
#   - foot's main.locked-title pins each window's title, so the sweep closes
#     exactly the windows this script opened — including any parked
#     off-screen by an earlier broken run.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/../lib/theme.sh"
root="$THEME_ROOT"
WS=5
KEEP=""
CLOSE_ONLY=""
while (($#)); do
  case "$1" in
    --keep) KEEP=1 ;;
    --close) CLOSE_ONLY=1 ;;
    --ws)
      shift
      WS="${1:?--ws needs a number}"
      ;;
  esac
  shift
done

need() { command -v "$1" >/dev/null || { echo "need $1" >&2; exit 1; }; }
for c in hyprctl grim magick jq foot btop fastfetch omarchy-dev-theme-preview wtype; do need "$c"; done

close_shot_windows() {
  while IFS= read -r a; do
    [[ -n $a ]] || continue
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null 2>&1
  done < <(hyprctl clients -j | jq -r '.[] | select(.title | startswith("bf-shot-")) | .address')
}

if [[ -n $CLOSE_ONLY ]]; then
  close_shot_windows
  exit 0
fi

current="$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)"
[[ $current == bright-future ]] ||
  echo "note: current theme is '${current:-unknown}', not bright-future — the shot will show it anyway" >&2

HOME_WS="$(hyprctl activeworkspace -j | jq -r '.id')"
read -r CUR_X CUR_Y < <(hyprctl cursorpos 2>/dev/null | tr -d ',')
CUR_X="${CUR_X:-0}" CUR_Y="${CUR_Y:-0}"

cleanup() {
  # Close the menu before returning to the user's workspace. Escape is safe if
  # the menu failed to open; it only reaches one of our staged terminals.
  wtype -k escape >/dev/null 2>&1 || true
  [[ -z $KEEP ]] && close_shot_windows
  hyprctl dispatch "hl.dsp.focus({ workspace = $HOME_WS })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.cursor.move({ x = $CUR_X, y = $CUR_Y })" >/dev/null 2>&1
}
trap cleanup EXIT

# A previous broken run may have left bf-shot-* windows parked off-screen;
# start from zero so addr_of never matches a corpse.
close_shot_windows
sleep 0.3

# Aim at the biggest unrotated landscape output, then pull the workspace there.
SHOT_MON="$(hyprctl monitors -j | jq -r '[.[] | select((.transform % 2) == 0 and .width > .height)] | sort_by(.width * .height) | last | .name')"
[[ -n $SHOT_MON && $SHOT_MON != null ]] || SHOT_MON="$(hyprctl monitors -j | jq -r '.[0].name')"
hyprctl dispatch "hl.dsp.focus({ monitor = \"$SHOT_MON\" })" >/dev/null 2>&1
sleep 0.3
hyprctl dispatch "hl.dsp.focus({ workspace = $WS })" >/dev/null 2>&1
sleep 0.4

read -r MX MY MW MH < <(hyprctl monitors -j | jq -r --arg m "$SHOT_MON" \
  '.[] | select(.name == $m) | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor)"')

# Reference composition, in logical coords: fetch left 45%, palette and btop
# stacked on the right, everything clear of the top bar.
TOP=40 M=14
LX=$((MX + M)); LY=$((MY + TOP))
AH=$((MH - TOP - M))
LW=$(((MW - 3 * M) * 45 / 100)); RW=$((MW - 3 * M - LW)); RX=$((LX + LW + M))
# Measured on this panel: btop cells are ~20.7px tall at size 10.5, so its
# pane must clear 24 rows ≈ 500px + padding; the palette pane's 25 content
# rows at size 8 need ~412px. 44/56 gives both a margin.
PH=$(((AH - M) * 44 / 100)); BH=$((AH - M - PH)); BY=$((LY + PH + M))

# Park spot for the pointer: another output if there is one, else the far
# corner of the shot monitor — grim only composites the cursor on the output
# it is physically on.
read -r PARK_X PARK_Y < <(hyprctl monitors -j | jq -r --arg m "$SHOT_MON" \
  '[.[] | select(.name != $m)] | if length > 0 then .[0] | "\(.x + 40) \(.y + 40)" else empty end')
PARK_X="${PARK_X:-$((MX + MW - 2))}" PARK_Y="${PARK_Y:-$((MY + MH - 2))}"

addr_of() { hyprctl clients -j | jq -r --arg t "$1" '.[] | select(.title == $t) | .address' | head -1; }

place() { # title x y w h — float it, size it, then position it: resize
  # re-centres a float, so the absolute move comes LAST.
  local t="$1" x="$2" y="$3" w="$4" h="$5" a="" i
  for i in {1..25}; do
    a="$(addr_of "$t")"
    [[ -n $a ]] && break
    sleep 0.1
  done
  [[ -n $a ]] || { echo "no window titled $t appeared" >&2; return 1; }
  hyprctl dispatch "hl.dsp.window.float({ action = \"on\", window = \"address:$a\" })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.window.resize({ x = $w, y = $h, window = \"address:$a\" })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, window = \"address:$a\" })" >/dev/null 2>&1
}

FETCH_FONT="JetBrainsMono Nerd Font:size=10.5"
PANE_FONT="JetBrainsMono Nerd Font:size=8"
BTOP_FONT="JetBrainsMono Nerd Font:size=10.5"

# Every pane draws only after a delay, so it renders once, at its final
# placed geometry — fastfetch's sixel logo does not survive a reflow.
setsid foot -o main.locked-title=yes --font "$FETCH_FONT" --title bf-shot-fetch \
  bash -c "sleep 1.8; clear; printf '\n'; fastfetch --logo '$root/backgrounds/5-low-orbit.png' --logo-type sixel --logo-width 36 --logo-padding-top 1; printf '\033[?25l'; exec sleep 900" >/dev/null 2>&1 &
setsid foot -o main.locked-title=yes --font "$PANE_FONT" --title bf-shot-palette \
  bash -c 'sleep 1.8; clear; printf "\n  \033[95m❯\033[0m omarchy dev theme-preview\n\n"; omarchy-dev-theme-preview --no-osc | awk "/^ANSI palette strips/ { f = 1 } f"; printf "\033[?25l"; exec sleep 900' >/dev/null 2>&1 &
setsid foot -o main.locked-title=yes --font "$BTOP_FONT" --title bf-shot-btop \
  bash -c 'sleep 1.8; exec btop' >/dev/null 2>&1 &

place bf-shot-fetch "$LX" "$LY" "$LW" "$AH"
place bf-shot-palette "$RX" "$LY" "$RW" "$PH"
place bf-shot-btop "$RX" "$BY" "$RW" "$BH"

# btop needs a few ticks of history before its graphs mean anything.
sleep 7

bt="$(addr_of bf-shot-btop)"
[[ -n $bt ]] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$bt\" })" >/dev/null 2>&1
sleep 0.4

# Put the real Omarchy menu in the foreground after the target monitor and
# workspace own focus. It is a layer surface, so opening it earlier can attach
# it to whichever monitor was active before staging.
wtype -M logo -k space -m logo
sleep 1.2

echo "--- staging state (evidence, not vibes)"
hyprctl monitors -j | jq -r '.[] | "  \(.name) pos=\(.x),\(.y) logical=\((.width / .scale) | floor)x\((.height / .scale) | floor) focused=\(.focused) ws=\(.activeWorkspace.id)"'
hyprctl clients -j | jq -r '.[] | select(.title | startswith("bf-shot-")) | "  \(.title) at=\(.at) size=\(.size) ws=\(.workspace.id) mon=\(.monitor)"'
hyprctl layers -j | jq -r --arg m "$SHOT_MON" '.[$m].levels | to_entries[] | .value[] | select(.namespace == "omarchy-menu") | "  menu namespace=\(.namespace) monitor='"$SHOT_MON"'"'
echo "  target: fetch=($LX,$LY ${LW}x$AH) palette=($RX,$LY ${RW}x$PH) btop=($RX,$BY ${RW}x$BH)"

# Shot hygiene: pointer off the capture, latched error banner closed, the
# notification layer cleared. None of this touches the config.
hyprctl dispatch "hl.dsp.cursor.move({ x = $PARK_X, y = $PARK_Y })" >/dev/null 2>&1
hyprctl seterror disable >/dev/null 2>&1
command -v makoctl >/dev/null && makoctl dismiss -a >/dev/null 2>&1
sleep 0.8

mkdir -p "$root/screenshots"
grim -o "$SHOT_MON" "$root/screenshots/terminals.png"

# Omarchy's theme-grid tile, at the size the shipped themes use; indexed to
# 256 colours to keep it near stock-theme weight.
magick "$root/screenshots/terminals.png" -strip -resize 1800x -colors 256 \
  -define png:compression-level=9 "$root/preview.png"

for f in "$root/screenshots/terminals.png" "$root/preview.png"; do
  printf '  %-40s %s  %d KB\n' "${f#"$root/"}" \
    "$(magick identify -format '%wx%h' "$f")" "$(($(stat -c %s "$f") / 1024))"
done
